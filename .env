# Branch Configuration
# Add new branches here as comma-separated values: NAME|CITY|CODE
# Example: VITE_BRANCHES=Bangalore|Bengaluru|BLR,Mumbai|Mumbai|MUM
VITE_BRANCHES=Bangalore|Bengaluru|BLR

# Branch Credentials
# Format: VITE_CREDS_<BRANCHCODE>=user1,user2,user3|sharedPassword
VITE_CREDS_BLR=blrsc1,blrsc2,blrsc3,blrsc4,blrsc5|Mli@123